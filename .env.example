# Copiez ce fichier en `.env` et remplissez vos valeurs (le fichier .env est ignoré par git).

# Clé du fournisseur de rédaction IA (facultative) — sans elle, les dossiers
# sont des brouillons techniques avec socle vérifié complet.
ASTROLAB_LLM_API_KEY=


# Compatible OpenAI : endpoint et modèle (facultatif).
ASTROLAB_LLM_BASE_URL=https://api.openai.com/v1
ASTROLAB_LLM_MODEL=gpt-4o-mini

# Désactive la partie commerciale dans l'interface.
ASTROLAB_ENABLE_COMMERCE=0

# Ferme les inscriptions publiques (mettre à 0 en test en ligne).
#ASTROLAB_ALLOW_REGISTRATION=1

# Chemin du fichier de données persistant (facultatif).
#ASTROLAB_DB_PATH=/Volumes/SSDA/Deep/AstroLab/data/astrolab.json

# Signature affichée en pied de chaque lecture/dossier (optionnel).
# Exemple : ASTROLAB_AUTHOR_LINE=Lecture relue et personnalisée par Bassam Hamadi
#ASTROLAB_AUTHOR_LINE=

# Paiement Stripe (Checkout intégré, prix fixe, paiement obligatoire).
# Sans ces clés, la lecture est générée sans paiement en développement (mode test).
# EN PRODUCTION, c'est refusé : une configuration de paiement manquante est une
# panne, pas un mode gratuit. Pour offrir les lectures sur un service en
# production, il faut le dire explicitement :
#ASTROLAB_ALLOW_FREE_READINGS=1
#
# Prix de la lecture et offre de lancement. Le prix est calculé par le serveur,
# jamais par le navigateur (voir src/payments/pricing.mjs, convention
# `lastro-pricing@1.0.0`). Le code promo est PUBLIC : il est pré-rempli dans le
# formulaire de paiement, donc visible de tous.
#ASTROLAB_PRICE_CENTS=2500
#ASTROLAB_PROMO_CODE=bessbousse10
#ASTROLAB_PROMO_DISCOUNT_CENTS=1000
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_PUBLISHABLE_KEY=pk_test_...
#STRIPE_CURRENCY=eur

# Accès gratuit réservé à l'exploitant : un code saisi dans le tunnel de paiement
# remplace le paiement (utile pour tester de bout en bout sans encaisser). Le code
# reste côté serveur, il n'apparaît jamais dans le JavaScript envoyé au navigateur.
# 12 caractères minimum ; à garder secret et à ne jamais committer dans le dépôt.
#ASTROLAB_TEST_CODE=

# Envoi des e-mails (lien de récupération d'une lecture) via Brevo.
# Sans clé, les e-mails restent dans la file interne : le client a toujours son
# lien affiché à l'écran, rien n'est perdu.
#BREVO_API_KEY=xkeysib-...
#BREVO_SENDER_EMAIL=info@lastro.fr
#BREVO_SENDER_NAME=Lastro

# Vérification d'adresse à l'inscription.
#   dev_code (défaut) : le code de vérification est renvoyé dans la réponse HTTP
#     et affiché à l'écran. Pratique en développement, À ÉVITER en production :
#     n'importe qui peut alors valider l'adresse d'un autre.
#   email : le code part par e-mail (Brevo) et n'est jamais renvoyé.
# Toute autre valeur explicite est traitée comme « email ».
# En production avec les inscriptions ouvertes, mettre : email
#ASTROLAB_EMAIL_MODE=email

# Vérification croisée de la lecture par un second modèle (Google Gemini).
# Sans clé, la vérification est simplement ignorée.
#GOOGLE_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash
#ASTROLAB_CROSS_CHECK=1

# Rendu PDF automatique côté serveur (facultatif, désactivé par défaut).
# Sans ce drapeau, le bouton PDF ouvre la fenêtre d'impression du navigateur :
# le client enregistre lui-même en PDF. Avec, le serveur renvoie un vrai fichier
# (sans la date ni l'adresse que le navigateur ajoute à l'impression).
# Nécessite une image construite avec --build-arg WITH_PDF_RENDERER=true
# (voir Dockerfile) : Chromium pèse plusieurs centaines de Mo de mémoire par
# conversion, ce qui n'est pas anodin sur une petite instance.
#ASTROLAB_PDF_RENDERER=chromium
# Chemin du binaire si Chromium n'est pas dans /usr/bin (facultatif).
#ASTROLAB_CHROMIUM_PATH=/usr/bin/chromium
# Délai maximum d'une conversion, en millisecondes (défaut 45000).
#ASTROLAB_PDF_TIMEOUT_MS=45000
# Fermeture du navigateur après ce temps d'inactivité (défaut 120000).
#ASTROLAB_PDF_IDLE_CLOSE_MS=120000
