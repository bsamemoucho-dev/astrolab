# Copiez ce fichier en `.env` et remplissez vos valeurs (le fichier .env est ignoré par git).

# Clé du fournisseur de rédaction IA (facultative) — sans elle, les dossiers
# sont des brouillons techniques avec socle vérifié complet.
ASTROLAB_LLM_API_KEY=


# Compatible OpenAI : endpoint et modèle (facultatif).
ASTROLAB_LLM_BASE_URL=https://api.openai.com/v1
ASTROLAB_LLM_MODEL=gpt-4o-mini

# Désactive la partie commerciale dans l'interface.
ASTROLAB_ENABLE_COMMERCE=0

# Ferme les inscriptions publiques (mettre à 0 en test en ligne).
#ASTROLAB_ALLOW_REGISTRATION=1

# Chemin du fichier de données persistant (facultatif).
#ASTROLAB_DB_PATH=/Volumes/SSDA/Deep/AstroLab/data/astrolab.json

# Signature affichée en pied de chaque lecture/dossier (optionnel).
# Exemple : ASTROLAB_AUTHOR_LINE=Lecture relue et personnalisée par Bassam Hamadi
#ASTROLAB_AUTHOR_LINE=

# Paiement Stripe (Checkout intégré, montant libre, paiement obligatoire).
# Sans ces clés, la lecture est générée sans paiement (mode test).
#STRIPE_SECRET_KEY=sk_test_...
#STRIPE_PUBLISHABLE_KEY=pk_test_...
#STRIPE_CURRENCY=eur

# Accès gratuit réservé à l'exploitant : un code saisi dans le tunnel de paiement
# remplace le paiement (utile pour tester de bout en bout sans encaisser). Le code
# reste côté serveur, il n'apparaît jamais dans le JavaScript envoyé au navigateur.
# 12 caractères minimum ; à garder secret et à ne jamais committer dans le dépôt.
#ASTROLAB_TEST_CODE=

# Envoi des e-mails (lien de récupération d'une lecture) via Brevo.
# Sans clé, les e-mails restent dans la file interne : le client a toujours son
# lien affiché à l'écran, rien n'est perdu.
#BREVO_API_KEY=xkeysib-...
#BREVO_SENDER_EMAIL=info@lastro.fr
#BREVO_SENDER_NAME=Lastro

# Vérification croisée de la lecture par un second modèle (Google Gemini).
# Sans clé, la vérification est simplement ignorée.
#GOOGLE_API_KEY=
#GEMINI_MODEL=gemini-2.5-flash
#ASTROLAB_CROSS_CHECK=1
